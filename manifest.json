{
  "manifest_version": 3,
  "name": "QR Code Injector",
  "version": "1.0",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["https://configurador.audi.pt/*", "https://www.worten.pt/*"],
  "background": { "service_worker": "content.js" },
  "content_scripts": [
      {
          "matches": ["https://configurador.audi.pt/*", "https://www.worten.pt/*"],
          "js": ["content.js"]
      }
  ]
}
